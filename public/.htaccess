Options -MultiViews
DirectoryIndex index.html

# Always fetch the current app shell, while hashed Vite assets can be cached safely.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep built assets as real files; never serve the SPA HTML for missing JS/CSS.
  RewriteRule ^assets/ - [L]

  # Serve existing files and folders directly, then route client-side URLs to Vite's entry page.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
